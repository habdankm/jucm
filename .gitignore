# Gradle / Java
# NOTE: explicit paths, not a bare `build/`: a directory named `build` anywhere else in the
# tree is not output of this project and must not be swallowed by accident.
.gradle/
/build/
config-*/build/
examples/*/build/
integration-tests/*/build/
out/
*.class

# IDE and editors
.idea/
*.iml
.vscode/

# machine paths (never put absolute paths into build outputs)
local.properties

# tools
.hermes/

# Files generated by the configurator in the working directory (artefacts, not sources):
# `application.sh` (CLI), `application.resolved.yaml` (YAML). `application.applied.yaml` was here already.
application.sh
application.resolved.yaml
