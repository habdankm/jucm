# Gradle / Java
# NOTE: an unanchored `build/` matches EVERY directory with that name in the tree —
# and the architecture spec has one (arch/architecture/build/). Hence the explicit paths.
.gradle/
/build/
config-*/build/
examples/*/build/
integration-tests/*/build/
out/
*.class

# IDE and editors
.idea/
*.iml
.vscode/

# machine paths (never put absolute paths into build outputs)
local.properties

# tools
.hermes/
# artefact of tools/scal.py
arch/_build/

# Files generated by the configurator in the working directory (artefacts, not sources):
# `application.sh` (CLI), `application.resolved.yaml` (YAML). `application.applied.yaml` was here already.
application.sh
application.resolved.yaml
local.properties
